        ["ITS","Delhi NCR","6.40","6.40","138","83","7","A","HubSpot+Google","2"],
        ["GL Bajaj","Delhi NCR","7.85","7.85","134","86","7","A","SAP MM+Six Sigma","2"],
        ["Lloyd Reg","Delhi NCR","8.00","7.90","125","85","5","B++","Google+HubSpot","3"],
        ["GIMS","Delhi NCR","8.37","8.27","127","84","6","A","NISM Series","3"],
        ["IMM BS","Delhi NCR","8.80","8.70","116","82","6","B++","Media+Google","3"],
        ["JIMS Kalkaji","Delhi NCR","9.50","9.40","115","84","6","B++","Google Analytics","3"],
        ["I Bus Inst","Delhi NCR","10.75","10.65","106","85","5","B+","SAP+Tableau","3"],
        ["Fostiima","Delhi NCR","10.95","10.95","126","88","7","A","Media+Google","2"],
        ["Asia Pacific","Delhi NCR","11.50","11.50","119","89","7","A+","Global+SAP","2"],
        ["IILM Univ","Delhi NCR","12.30","12.30","107","86","8","A","SAP FICO+Digital","2"],
        ["SOIL Inst","Delhi NCR","16.10","16.10","106","92","8","A+","CFA+SHRM","2"],
        ["Welingkar","Mumbai","14.00","14.00","129","94","8","A++","CFA+Bloomberg+AWS","1"],
        ["ITM Navi Mum","Mumbai","10.95","10.95","123","87","8","A+","Tableau+Python","2"],
        ["AI Univ Single","Mumbai","9.48","9.38","123","85","6","B++","Google Analytics","3"],
        ["SOA Univ","Bhubaneswar","7.00","6.90","150","88","8","A++","NISM+AWS+Google","1"],
        ["KIIT","Bhubaneswar","15.00","15.00","117","93","9","A++","Google ML+AWS","1"],
        ["Graphics Era","Dehradun","8.00","8.00","144","89","7","A+","SAP FICO+Six Sigma","2"],
        ["DBS Reg","Dehradun","9.00","8.90","112","84","6","A","Google+HubSpot","3"],
        ["UPES","Dehradun","16.50","16.50","106","92","9","A+","Energy+SAP+AWS","1"]
    ];

    // Build college objects
    const colleges = rawColleges.map((r, idx) => ({
        id: idx,
        name: r[0],
        city: r[1],
        originalFees: parseFloat(r[2]),
        finalFees: parseFloat(r[3]),
        roi: r[4] ? parseFloat(r[4]) : null,
        placement: r[5] ? parseFloat(r[5]) : null,
        infra: parseFloat(r[6]),
        naac: r[7],
        certsRaw: r[8],
        tier: parseInt(r[9], 10),
        certCount: r[8] ? r[8].split('+').length : 0
    }));

    // ----- List of preferred colleges (exact names as in data) -----
    const preferredNames = [
        // Kolkata
        "CBS Kolkata",
        "EIILM Kolkata",
        "United World",
        "Praxis Kolkata",
        // Bangalore
        "Izee BS",
        "ABBS Bangalore",
        "RCM Bangalore",
        "KCM Bangalore",
        "Alliance Accent",
        "Presidency",
        // Pune
        "PIBM",
        "IIMS Pune",
        "DY Patil Reg",
        "Lexicon MILE",
        // Delhi NCR
        "Lloyd Reg",
        "GIMS",
        "JIMS Kalkaji",
        "GL Bajaj"
        // (Jaipuria not in data, so omitted)
    ];

    // Create a Set for fast lookup
    const preferredSet = new Set(preferredNames);
    const PREFERRED_MULTIPLIER = 1.20; // 20% boost

    // ----- Helper: NAAC grade to numeric -----
    function naacToScore(grade) {
        if (!grade) return 2.0;
        const g = grade.trim().toUpperCase();
        if (g === 'A++') return 5.0;
        if (g === 'A+') return 4.5;
        if (g === 'A') return 4.0;
        if (g === 'B++') return 3.5;
        if (g === 'B+') return 3.0;
        if (g === 'B') return 2.5;
        return 2.0;
    }

    // Precompute min/max for normalization (over all colleges)
    const stats = {
        placement: { min: 100, max: 0 },
        roi: { min: 1000, max: 0 },
        naacScore: { min: 5, max: 0 },
        infra: { min: 10, max: 0 },
        certCount: { min: 100, max: 0 }
    };

    colleges.forEach(c => {
        if (c.placement !== null) {
            stats.placement.min = Math.min(stats.placement.min, c.placement);
            stats.placement.max = Math.max(stats.placement.max, c.placement);
        }
        if (c.roi !== null) {
            stats.roi.min = Math.min(stats.roi.min, c.roi);
            stats.roi.max = Math.max(stats.roi.max, c.roi);
        }
        const ns = naacToScore(c.naac);
        stats.naacScore.min = Math.min(stats.naacScore.min, ns);
        stats.naacScore.max = Math.max(stats.naacScore.max, ns);
        stats.infra.min = Math.min(stats.infra.min, c.infra);
        stats.infra.max = Math.max(stats.infra.max, c.infra);
        stats.certCount.min = Math.min(stats.certCount.min, c.certCount);
        stats.certCount.max = Math.max(stats.certCount.max, c.certCount);
    });

    function normalize(value, min, max) {
        if (max === min) return 0.5;
        return (value - min) / (max - min);
    }

    // ----- Filtering and scoring (with preferred multiplier) -----
    function getTopColleges(selectedCriteria, budgetRange, selectedCities) {
        // Parse budget
        let minFee = 0, maxFee = Infinity;
        if (budgetRange === '0-8') { minFee = 0; maxFee = 8; }
        else if (budgetRange === '8-10') { minFee = 8; maxFee = 10; }
        else if (budgetRange === '10-15') { minFee = 10; maxFee = 15; }
        else if (budgetRange === '15-20') { minFee = 15; maxFee = 20; }
        else if (budgetRange === '20-above') { minFee = 20; maxFee = Infinity; }

        // Filter by city and budget
        let filtered = colleges.filter(c => 
            selectedCities.includes(c.city) && 
            c.finalFees >= minFee && 
            c.finalFees <= maxFee
        );

        if (filtered.length === 0) return [];

        // Score each college
        const scored = filtered.map(college => {
            let rawScore = 0;
            selectedCriteria.forEach(crit => {
                if (crit === 'placement' && college.placement !== null) {
                    rawScore += normalize(college.placement, stats.placement.min, stats.placement.max);
                } else if (crit === 'roi' && college.roi !== null) {
                    rawScore += normalize(college.roi, stats.roi.min, stats.roi.max);
                } else if (crit === 'ranking') {
                    rawScore += normalize(naacToScore(college.naac), stats.naacScore.min, stats.naacScore.max);
                } else if (crit === 'infra') {
                    rawScore += normalize(college.infra, stats.infra.min, stats.infra.max);
                } else if (crit === 'cert') {
                    rawScore += normalize(college.certCount, stats.certCount.min, stats.certCount.max);
                }
            });

            // Apply multiplier if college is in preferred set
            const finalScore = preferredSet.has(college.name) ? rawScore * PREFERRED_MULTIPLIER : rawScore;

            return { college, score: finalScore };
        });

        // Sort descending by final score
        scored.sort((a, b) => b.score - a.score);
        return scored.slice(0, 3).map(item => item.college);
    }

    // ----- Render college cards -----
    function renderColleges(collegesArray) {
        const container = document.getElementById('collegeContainer');
        const countSpan = document.getElementById('resultCount');
        if (!collegesArray || collegesArray.length === 0) {
            container.innerHTML = `<div class="error-msg">✨ No colleges match your filters. Try expanding budget or cities.</div>`;
            countSpan.innerText = '0';
            return;
        }
        countSpan.innerText = collegesArray.length;
        let html = '';
        collegesArray.forEach(c => {
            const naacDisplay = c.naac || 'N/A';
            const certDisplay = c.certsRaw || '—';
            const placementDisplay = c.placement !== null ? c.placement + '%' : '—';
            const roiDisplay = c.roi !== null ? c.roi + '%' : '—';
            const infraDisplay = c.infra + '/10';
            const isPreferred = preferredSet.has(c.name);
            html += `
                <div class="college-card">
                    <div class="college-name">${c.name} ${isPreferred ? '⭐' : ''}</div>
                    <div class="city-tag">📍 ${c.city}</div>
                    <div class="metrics">
                        <div class="metric"><span class="label">Fees (final)</span><div class="value">₹${c.finalFees}L</div></div>
                        <div class="metric"><span class="label">ROI</span><div class="value">${roiDisplay}</div></div>
                        <div class="metric"><span class="label">Placement</span><div class="value">${placementDisplay}</div></div>
                        <div class="metric"><span class="label">Infra</span><div class="value">${infraDisplay}</div></div>
                        <div class="metric"><span class="label">NAAC</span><div class="value">${naacDisplay}</div></div>
                    </div>
                    <div class="certs"><span>📌 certifications</span>${certDisplay}</div>
                    <div class="tier-badge">Tier ${c.tier}</div>
                </div>
            `;
        });
        container.innerHTML = html;
    }

    // ----- Event listener -----
    document.getElementById('findBtn').addEventListener('click', () => {
        const budgetRadio = document.querySelector('input[name="budget"]:checked');
        const budgetRange = budgetRadio ? budgetRadio.value : '0-8';

        const cityCheckboxes = document.querySelectorAll('#cityGroup input[type=checkbox]');
        const selectedCities = [];
        cityCheckboxes.forEach(cb => { if (cb.checked) selectedCities.push(cb.value); });

        const priorityCheckboxes = document.querySelectorAll('#criteriaGroup input[type=checkbox]');
        const selectedCriteria = [];
        priorityCheckboxes.forEach(cb => { if (cb.checked) selectedCriteria.push(cb.value); });

        if (selectedCities.length === 0) {
            alert('Please select at least one city.');
            return;
        }
        if (selectedCriteria.length === 0) {
            alert('Please select at least one priority.');
            return;
        }

        const top3 = getTopColleges(selectedCriteria, budgetRange, selectedCities);
        renderColleges(top3);
    });

    // ----- Initial load (default: budget 0-8, all cities, placement/roi/ranking) -----
    window.addEventListener('load', () => {
        const defaultCriteria = ['placement', 'roi', 'ranking'];
        const defaultCities = ['Kolkata','Bangalore','Hyderabad','Pune','Delhi NCR','Mumbai','Bhubaneswar','Dehradun'];
        const top3 = getTopColleges(defaultCriteria, '0-8', defaultCities);
        renderColleges(top3);
    });
})();
</script>
</body>
</html>
